# 复制成 .env 后填真实值。.env 已在 .gitignore 里。
#
# 端口是 **5433** 不是 5432：宿主 5432 常被别的项目的 pgvector 容器占着，
# ganyu 的 compose 映射到 5433（容器内仍是 5432）。
DATABASE_URL=postgresql://rdi:rdi@localhost:5433/rdi

# PaddleOCR 云端 API 的 token —— 只有要重新 OCR 扫描件时才需要。
# 指南全文不在版本库里，clone 之后要自己 OCR 出入库源：
#     PADDLEOCR_TOKEN=xxx make ocr PDF=<pdf 路径>
PADDLEOCR_TOKEN=

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 超时（秒）。模型名和这个超时**前端也能改**（顶栏 LLM 那个 badge），
# 改完立刻生效，不用重启 —— 但只影响本进程，重启就没了。
LLM_TIMEOUT_S=120
# 重试次数。超时 × 重试 = 最坏等待时间。
# 3 次的话是 6 分钟，家长面对一个不动的按钮；2 次是"还值得再等等"的上限。
LLM_MAX_ATTEMPTS=2

EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# live / replay / capture
DEMO_MODE=live

# 关键词检索后端：postgres_fts（默认）| paradedb_bm25
KEYWORD_BACKEND=postgres_fts

RAG_ENABLED=true
MEMORY_ENABLED=true

# 追问轮数上限（两处，分开配）
# 新会话开始时问家长要信息，追几轮
FOLLOWUP_MAX_ROUNDS=1
# 选了方案卡、录完反馈之后的追问，追几轮
FEEDBACK_FOLLOWUP_MAX_ROUNDS=1

RERANK_ENABLED=true
